{
  "name": "tinysend-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub action: send email to your audience from any workflow",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js",
