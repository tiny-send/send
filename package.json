    "test": "npm run typecheck && npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "marked": "^15.0.0",
    "tinysend": "^0.2.0",
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0"
  }
}
